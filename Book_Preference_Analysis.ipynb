print("Remaining rows will be:", len(users) - users['Age'].isna().sum())
#Remove rows with missing age
users = users.dropna(subset=['Age'])
print("Before age filter:", len(users))
#check how many fall outside 5-100
too_young = (users['Age'] < 5).sum()
too_old = (users['Age'] > 100).sum()
print("Ages below 5:", too_young)
print("Ages above 100:", too_old)
print("Total unrealistic ages:", too_young + too_old)
#Apply the filter
users = users[(users['Age'] >= 5) & (users['Age'] <= 100)]
print("After age filter:", len(users))
print("Rows removed:", too_young + too_old)
#Convert age to integer
users['Age'] = users['Age'].astype(int)
print("\nUsers after cleaning:", users.shape)
#Filter the Age group
def assign_age(age):
    if age < 13:
        return 'Kids'
    elif age < 18:
        return 'Teens'
    elif age < 26:
        return 'Young Adults'
    elif age < 41:
        return 'Adults'
    elif age < 61:
        return 'Middle Aged'
    else:
        return 'Seniors'
users['Age_Group'] = users['Age'].apply(assign_age)
print(users['Age_Group'].value_counts())

#Cleaning books data

#Keep only relevant columns
books = books[['ISBN', 'Book-Title', 'Book-Author', 'Year-Of-Publication', 'Publisher']]
#Drop duplicates
books = books.drop_duplicates(subset='ISBN')
#Drop missing values
books = books.dropna()
print("Books after cleaning:", books.shape)
# Keep only explicit ratings (1-10), remove 0s (implicit/unrated)
rating = rating[rating['Book-Rating'] > 0]
print("Ratings after cleaning:", rating.shape)
print(rating['Book-Rating'].value_counts().sort_index())
rating.shape

# Merge ratings with users
df = rating.merge(users, on='User-ID', how='inner')
# Merge with books
df = df.merge(books, on='ISBN', how='inner')
print("Final merged dataset:", df.shape)
display(df.head(3))
print(df.columns)

# Genre Mapping (because the kaggle dataset doesnot have genre column)
# Priority genres (run this once and save it)
MAIN_GENRES = [
    'Fiction', 'Mystery', 'Romance', 'Science Fiction', 'Fantasy',
    'Horror', 'History', 'Biography', 'Children', 'Thriller',
    'Adventure', 'Poetry', 'Comics', 'Self-help', 'Religion',
    'Philosophy', 'Psychology', 'Travel', 'Cooking', 'Science']

def get_genre(isbn):
    try:
        url = f"https://openlibrary.org/api/books?bibkeys=ISBN:{isbn}&format=json&jscmd=data"
        response = requests.get(url, timeout=5)
        data = response.json()
        key = f"ISBN:{isbn}"
        if key in data and 'subjects' in data[key]:
            subjects = [s['name'] for s in data[key]['subjects']]
            #Try to match a known genre first
            for subject in subjects:
                for genre in MAIN_GENRES:
                    if genre.lower() in subject.lower():
                        return genre
            #If no match, return first subject
            return subjects[0]
        return 'Unknown'
    except:
        return 'Unknown'
#Get the most frequently rated ISBNs instead of random sample
top_isbns = df['ISBN'].value_counts().head(5000).index.tolist()
print("Top ISBNs to fetch:", len(top_isbns))
#run only once
isbn_genre_map = {}
for isbn in tqdm(top_isbns):  #changed from sample_isbns to top_isbns
    isbn_genre_map[isbn] = get_genre(isbn)
    time.sleep(0.5)
print("Done! Sample:", list(isbn_genre_map.items())[:5])
# Saving the file
with open('data/isbn_genre_map.json', 'w') as f:
    json.dump(isbn_genre_map, f)
print("isbn_genre_map.json saved!")

df['Genre'] = df['ISBN'].map(isbn_genre_map)
df['Genre'] = df['Genre'].apply(
    lambda x: x if x in MAIN_GENRES else None)
df_genre = df.dropna(subset=['Genre'])
df_genre = df_genre.dropna(subset=['Age'])
df_genre['Age'] = df_genre['Age'].astype(int)
df_genre.to_csv('data/df_genre.csv', index=False)
print("df_genre.csv saved!")
print("Shape:", df_genre.shape)

