#Overall Genre Distribution
import plotly.express as px

#Count each genre
genre_counts = df_genre['Genre'].value_counts().reset_index()
genre_counts.columns = ['Genre', 'Count']

#Plot interactive pie chart
fig = px.pie(
    genre_counts,
    names='Genre',
    values='Count',
    title='Overall Genre Distribution',
    hole=0.3,  # makes it a donut chart (remove this line for full pie)
    color_discrete_sequence=px.colors.qualitative.Set3)

fig.update_traces(
    textposition='inside',
    textinfo='percent+label',
    hovertemplate='<b>%{label}</b><br>Count: %{value}<br>Percentage: %{percent}<extra></extra>')

fig.update_layout(
    title_font_size=20,
    legend_title='Genre',
    showlegend=True)
fig.show()

